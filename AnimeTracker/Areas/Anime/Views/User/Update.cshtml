
@{
    Layout = "_Layout";
}

@model AnimeTracker.Areas.Anime.Models.UpdateAnimevm



<div class="m-5" id="exampleModal">
    <form method="post" asp-area="Anime" asp-controller="Home" asp-action="Update" enctype="multipart/form-data">
        
        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Name</label>
            <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="name" asp-for="AnimeName"/>
        </div>

        <div class="form-group">
            <select class="form-control" asp-for="CategoryId" multiple>
                @foreach (var category in Model.CategoryList)
                {
                    <option value="@category.Value">@category.Text</option>
                }
            </select>
        </div>


        <div class="form-group">
            <label for="">Type:</label>
            <select class="form-control" asp-for="Type">
                <option value="Anime">Anime</option>
                <option value="Manga">Manga</option>
                <option value="Movie">Movie</option>
            </select>
        </div>

        <div class="mb-3">
            @* <label for="imageFile" class="form-label">Image</label> *@

            <input type="file" class="form-control" id="imageFile" name="ImageFile"/>
        </div>
        <input type="submit"/>
    </form>
</div>


