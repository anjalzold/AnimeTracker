
@{
    Layout = "_Layout";
}

@model AnimeTracker.Areas.Anime.Models.Uservm



<div class="m-5 bg-white p-5 w-50 w-[1200px] mx-auto" id="exampleModal">
    <p class="text-center">Update User</p>
    <form method="post" asp-area="Anime" asp-controller="User" asp-action="Update" enctype="multipart/form-data">

        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Name</label>
            <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="name" asp-for="FullName"/>
        </div>
        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">UserName</label>
            <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="name" asp-for="UserName"/>
        </div>
        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Email</label>
            <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="name" asp-for="UserEmail"/>
        </div>
        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Password</label>
            <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="name" asp-for="UserPassword"/>
        </div>
        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Role</label>
            <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="name" asp-for="Role"/>
        </div>



        <input  type="submit"/>
    </form>
</div>


