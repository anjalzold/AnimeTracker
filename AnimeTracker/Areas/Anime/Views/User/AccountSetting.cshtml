@model List<AnimeTracker.Areas.Anime.Models.Uservm>
@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}


<div>
    <div class="card m-5">
        <h5 class="card-header"></h5>
        <div class="table-responsive text-nowrap">
            <table class="table table-image">
                <thead>
                <tr>
                    <th></th>
                    <th>UserName</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Password</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="w-25 h-50">  

                            <img src=@user.ImagePath class="object-fit-scale" width="100" height="100"/>

                        </td>
                        <td>

                            @user.UserName

                        </td>
                        <td>@user.FullName</td>
                        <td>
                            @user.UserEmail
                        </td>
                        <td>
                            @user.Role
                        </td>
                        <td>
                            @user.UserPassword
                        </td>
                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="bx bx-dots-vertical-rounded"></i>
                                </button>

                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-route-id="@user.UserId" asp-area="Anime" asp-controller="User" asp-action="Update">
                                        <i class="bx bx-edit-alt me-2"></i> Edit
                                    </a>
                                    <a class="dropdown-item" asp-route-id="@user.UserId" asp-area="Anime" asp-controller="User" asp-action="Delete">
                                        <i class="bx bx-trash me-2"></i> Delete
                                    </a>
                                </div>


                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

</div>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Get the last scroll position from localStorage
        var lastScrollPosition = localStorage.getItem('lastScrollPosition');

        // If a scroll position was previously saved, scroll to it
        if (lastScrollPosition) {
            window.scrollTo(0, lastScrollPosition);
        }

        // Save the scroll position when the user scrolls
        window.addEventListener('scroll', function () {
            localStorage.setItem('lastScrollPosition', window.scrollY);
        });
    });
</script>