@{
    Layout = "_Layout";
}

@model AnimeTracker.Areas.Anime.Models.UpdateAnimevm



<div class="m-5 bg-white p-5 w-50 w-[1200px] mx-auto" id="exampleModal">
    <p class="text-center">Update Anime Details</p>
    <form method="post" asp-area="Anime" asp-controller="Home" asp-action="Update" enctype="multipart/form-data"
        class="px-4">

        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Name</label>
            <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="name"
                asp-for="AnimeName" />
        </div>

        <div class="form-group mb-4">
            <label class="mb-2">Category</label>
            <select class="form-control" asp-for="CategoryId" multiple>
                @foreach (var category in Model.CategoryList)
                {
                    <option value="@category.Value">@category.Text</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Description</label>
            <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="name"
                asp-for="Description" />
        </div>


        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Episode / Chapter</label>
            <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="Total Episode"
                asp-for="Episode" />
        </div>

        <div class="form-group mb-4">
            <label class="mb-2">Type:</label>
            <select class="form-control" asp-for="Type">
                <option value="Anime">Anime</option>
                <option value="Manga">Manga</option>
                <option value="Movie">Movie</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="imageFile" class="mb-2">Change Image</label>

            <input type="file" class="form-control" id="imageFile" name="ImageFile" />
        </div>
        <input type="submit" />
    </form>
</div>
