@using AnimeTracker.Enums
@model AnimeTracker.ViewModel.UserAnimeVm

@{
    Layout = "_Layout";
}

<h2>Edit Anime Progress</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<div class="p-5">
    <form  asp-controller="Temp" asp-action="TempForm" method="post" style="color: white">
        <input type="hidden" asp-for="AnimeId" />
        <input type="hidden" asp-for="UserId" />
        <div class="form-group">
            <label asp-for="AnimeName" ></label>
            <input asp-for="AnimeName" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label asp-for="Episode">Current Episode</label>
            <input asp-for="Episode" class="form-control" />
        </div>
        <div class="form-group">
            @* <label asp-for="Status">Status</label> *@
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<Status>()" class="form-control">
                <option value="">-- Select Status --</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Update</button>
    </form>
</div>
