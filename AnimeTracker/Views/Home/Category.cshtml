@model List<AnimeTracker.Areas.Anime.Models.Animevm>
@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}


@* <div> *@
@*     @foreach (var anime in Model) *@
@*     { *@
@*         <h1>@anime.AnimeName</h1> *@
@*         <img src="~/images/@anime.ImageFileName"/> *@
@*         <p>@anime.CategoryName</p> *@
@* *@
@*     } *@
@* </div> *@

<div>

<!-- Product Section Begin -->
<section class="product spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="trending__product">
                    <div class="row">
                        <div class="col-lg-8 col-md-8 col-sm-8">
                            @foreach (var category in Model.Take(1))
                            {
                                <div class="section-title">
                                    <h4>@category.CategoryName</h4>
                                </div>
                            }
                       
                        </div>
                      
                    </div>
                    <div class="row">
                        @foreach (var anime in Model)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-6">
                                <div class="product__item">
                                    <div class="product__item__pic set-bg" data-setbg="/images/@anime.ImageFileName">
                                        <div class="ep">@anime.Episode</div>
                                        @* <div class="comment"><i class="fa fa-comments"></i> 11</div> *@
                                        <div class="view"><i class="fa fa-eye"></i> @anime.ViewCount</div>
                                    </div>
                                    <div class="product__item__text">
                                        <ul>
                                            @* <li>Active</li> *@
                                            <li>@anime.Type</li>
                                        </ul>
                                        <h5>
                                            <a asp-route-id="@anime.AnimeId" asp-controller="Home" asp-action="AnimeDetail">@anime.AnimeName</a>
                                        </h5>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>


                </div>
            </div>
        </div>
    </div>


</section>

<a asp-controller="Home" asp-action="CategoryPage">Category Page</a>
</div>