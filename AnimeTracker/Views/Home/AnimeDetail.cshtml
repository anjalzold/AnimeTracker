@using AnimeTracker.Enums
@using Microsoft.IdentityModel.Tokens
@model AnimeTracker.ViewModel.UserAnimeVm
@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<div asp-validation-summary="All"></div>





<!-- Main Content Container (800px width) -->
<div class="container mt-4">
    <div class="row">
        <!-- Left Side (Image and Select Box) -->
        <div class="col-md-4">
            <img src="~/images/@Model.Image" alt="Anime Image" class="object-fit-cover" style="object-fit: cover"
                height="400" width="400">
            @if (Model.UserId != Guid.Empty)
            @* @if (Model.AnimeId != Guid.Empty) *@

            {
                <div class="mt-3 mb-4">
                    <div class="p-0 py-2 px-2  " style="">
                        <form asp-controller="Home" asp-action="AnimeDetail" method="post" class="" id="animeDetailForm"
                            style="max-width: 500px">
                            <input type="hidden" asp-for="AnimeId" />
                            <input type="hidden" asp-for="UserId" />

                            <div class="">
                                <div class="">
                                    <label for="rating" class="text-white">Rate this anime:</label>
                                    <input type="number" id="ratings" min="0" max="10"
                                        asp-for="TotalRatings" class="border-0 m-0 p-0" />
                                </div>
                                <div class=" d-flex" style="width: 500px">
                                    <div class="d-flex text-center pr-3">
                                        <div class="d-flex align-items-center">
                                            
                                            <input asp-for="Episode" type="number" max="@Model.TotalEpisode"
                                                class="border-0 p-2 " style="width: 60px" id="episodeInput"
                                                aria-describedby="total-episode" />

                                                @if(Model.TotalEpisode != 0){
                                                         <span class="bg-white p-2"
                                                style="margin-left: -1px;">/@Model.TotalEpisode</span>
                                                }
                                       
                                        </div>
                                    </div>
                                    <div class="">
                                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<Status>()" class="">
                                            @if (Html.GetEnumSelectList<Status>() == null)
                                            {
                                                <option class="" style=""> Select Status </option>

                                            }
                                        </select>
                                    </div>
                                    <div class="">
                                        <button type="submit" class="btn btn-primary">Set</button>

                                    </div>
                                </div>








                            </div>

                            @* <div class="d-flex" style="width: 100%"> *@
                            @* *@
                            @* @if (Model.UserId != Guid.Empty) *@
                            @* { *@
                            @* *@
                            @* } *@
                            @* else *@
                            @* { *@
                            @* <select class="text-black d-block" aria-label="Default select example" id="statusSelect"
                        type="submit"> *@
                            @* <option selected>Select Status</option> *@
                            @* <option value="1">Planned</option> *@
                            @* <option value="2">Watching</option> *@
                            @* <option value="3">Completed</option> *@
                            @* </select> *@
                            @* } *@
                            @* $1$ <label asp-for="Status">Status</label> #1# *@
                            @* *@
                            @* </div> *@
                        </form>
                    </div>

                </div>
            }

        </div>

        <!-- Right Side (Anime Name, Episode, Description) -->
        <div class="col-md-8 text-white">
            @if(Model.AnimeName != null){
            <h2>@Model.AnimeName.ToUpper()</h2>

            }

@if (Model.Description != null)
            {
                <p>
                    @Model.Description
                </p>
            }
          @if(Model.ViewCount != 0){
              <p>
                Total Views @Model.ViewCount
            </p>
          }
          @if(Model.Ratings != 0){
            <p>
                Average Rating @Model.Ratings
            </p>
          }
         
            <div class="blog__details__tags">
                <p>
                    @if(Model.category != null){
                    @foreach (var a in Model.category)
                    {
                        <a asp-route-categoryName="@a" asp-controller="Home" asp-action="Category">@a</a>
                    }
                    }
                  
                </p>
            </div>
        </div>
    </div>

  <form asp-controller="Home" asp-action="AddComment" method="post">
    <input type="hidden" asp-for="AnimeId" />
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="UserName" />
    <textarea  asp-for="Comment"></textarea>
    <input type="submit" value="Add Comment">
</form>



@if(Model.CommentDetails != null){

    @foreach (var commentDetail in Model.CommentDetails)
{
    <div class="comment">
        <p style="color: white;"><strong>@commentDetail.UserName:</strong> @commentDetail.Comment</p>
    </div>
}

    }








</div>


