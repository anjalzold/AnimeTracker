<div class="container">
    <div class="row">


        <div class="col-lg-9">
            <div class="container filter-container mt-5 ">
                <form method="post" asp-controller="Home" asp-action="Index" id="filterForm">
                    <div class="" style="display: grid; grid-template-columns: 200px 200px 200px 100px; column-gap: 20px;grid-template-rows: 100px ">
                        <!-- Search Field -->
                        <div style="display: flex; flex-direction: column">
                            <label for="searchField" class="text-white">Search</label>
                            <input type="text" class="form-control" id="searchField" placeholder="Enter your search" style="padding: 20px" name="search">
                        </div>

                        <!-- Genre Dropdown -->
                        <div style="display: flex; flex-direction: column">
                            <label for="genreDropdown" class="text-white">Genre</label>
                            <select class="form-control" id="genreAnime" style="" name="cate">
                                <option value="">Select Genre</option>
                                <option value="adventure">Adventure</option>
                                <option value="comedy">Comedy</option>
                                <option value="drama">Drama</option>
                            </select>
                        </div>

                        <!-- Content Type Dropdown -->
                        <div style="display: flex; flex-direction: column">
                            <label for="contentTypeDropdown" class="text-white">Content Type</label>
                            <select class="form-control" id="typeAnime" name="type">
                                <option value="">Select Content Type</option>
                                <option value="movie">Movie</option>
                                <option value="anime">Anime</option>
                                <option value="manga">Manga</option>
                            </select>
                        </div>
                        <div style="display:flex;flex-direction: column;">
                            <button type="submit" class="btn btn-primary" id="submitBtn" style="margin-top: 35px ">Submit</button>

                        </div>


                        <!-- Submit Button -->
                    </div>
                </form>
            </div>


            <section class="product spad">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="trending__product">
                                <div class="row">
                                    <div class="col-lg-8 col-md-8 col-sm-8">
                                         @if (Model.Any(item => item.Type == "Anime"))
                                        {
                                            <div class="section-title">
                                            <h4> Anime List</h4>
                                        </div>  
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    @foreach (var animeinfo in Model.Where(item => item.Type == "Anime"))
                                    {
                                        <div class="col-lg-4 col-md-6 col-sm-6">
                                            <a asp-route-id="@animeinfo.AnimeId" asp-controller="Home" asp-action="AnimeDetail">

                                                <div class="product__item">
                                                    <div class="product__item__pic set-bg" data-setbg="images/@animeinfo.ImageFileName">
                                                        <div class="ep">@animeinfo.Episode</div>
                                                        @* <div class="comment"><i class="fa fa-comments"></i> 11</div> *@
                                                        <div class="view">
                                                            <i class="fa fa-eye"></i> @animeinfo.ViewCount
                                                        </div>
                                                    </div>
                                                    <div class="product__item__text">
                                                        @* <ul>
                                                            <li>@animeinfo.Type</li>
                                                        </ul> *@
                                                        <h5 class="text-white fw-bold" style="font-weight: bold; font-size: 18px;">
                                                            @animeinfo.AnimeName
                                                        </h5>
                                                    </div>
                                                </div>
                                            </a>

                                        </div>
                                    }
                                </div>
                            </div>

                        </div>


                    </div>
                </div>
            </section>

            <!-- Create similar sections for manga and movies -->
            <section class="product spad">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="trending__product">
                                <div class="row">
                                    <div class="col-lg-8 col-md-8 col-sm-8">
                                         @if (Model.Any(item => item.Type == "Manga"))
                                        {
                                            <div class="section-title">
                                            <h4> Manga List</h4>
                                        </div>  
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    @foreach (var mangaInfo in Model.Where(item => item.Type == "Manga"))
                                    {
                                        <div class="col-lg-4 col-md-6 col-sm-6">
                                                                                        <a asp-route-id="@mangaInfo.AnimeId" asp-controller="Home" asp-action="AnimeDetail">

                                            <div class="product__item">
                                                <div class="product__item__pic set-bg" data-setbg="/images/@mangaInfo.ImageFileName">
                                                    <div class="ep">@mangaInfo.Episode</div>
                                                    @* <div class="comment"><i class="fa fa-comments"></i> 11</div> *@
                                                    <div class="view">
                                                        <i class="fa fa-eye"></i> @mangaInfo.ViewCount
                                                    </div>
                                                </div>
                                                <div class="product__item__text">
                                                    @* <ul>
                                                        <li>@mangaInfo.Type</li>
                                                    </ul> *@
                                                       <h5 class="text-white fw-bold" style="font-weight: bold; font-size: 18px;">
                                                            @mangaInfo.AnimeName
                                                        </h5>
                                                </div>
                                            </div>
                                                                                            </a>

                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>



                                 

            <section class="product spad">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="trending__product">
                                <div class="row">
                                    <div class="col-lg-8 col-md-8 col-sm-8">
                                        @if (Model.Any(item => item.Type == "Movie"))
                                        {
                                            <div class="section-title">
                                            <h4> Movie List</h4>
                                        </div>  
                                        }

                                      
                                    </div>
                                </div>
                                <div class="row">
                                    @foreach (var movieInfo in Model.Where(item => item.Type == "Movie"))
                                    {
                                        <div class="col-lg-4 col-md-6 col-sm-6">
                                                                                                                                    <a asp-route-id="@movieInfo.AnimeId" asp-controller="Home" asp-action="AnimeDetail">

                                            
                                            <div class="product__item">
                                                <div class="product__item__pic set-bg" data-setbg="/images/@movieInfo.ImageFileName">
                                                    <div class="ep">@movieInfo.Episode</div>
                                                    @* <div class="comment"><i class="fa fa-comments"></i> 11</div> *@
                                                    <div class="view">
                                                        <i class="fa fa-eye"></i> @movieInfo.ViewCount
                                                    </div>
                                                </div>
                                                <div class="product__item__text">
                                                    <ul>
                                                        <li>@movieInfo.Type</li>
                                                    </ul>
                                                       <h5 class="text-white fw-bold" style="font-weight: bold; font-size: 18px;">
                                                            @movieInfo.AnimeName
                                                        </h5>
                                                </div>
                                            </div>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>


                    </div>
                </div>
            </section>
        </div>
        <div class="col-lg-3">
            <partial name="_SidebarAnime" model="@Model"></partial>
                        <partial name="_TopRated" model="@Model"></partial>

        </div>
    </div>

</div>




