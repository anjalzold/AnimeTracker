@using Microsoft.IdentityModel.Tokens
@model List<AnimeTracker.ViewModel.UserAnimeVm>

@{
    Layout = "_Layout";
}


<div asp-validation-summary="All"></div>


@if (@Model.IsNullOrEmpty())
{
    <div>
        No Any anime
    </div>
}
<section class="product spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="trending__product">
                    <div class="row">
                        <div class="col-lg-8 col-md-8 col-sm-8">
                            <div class="section-title">
                                <h4>Your Anime List</h4>
                            </div>
                        </div>
                        </div>
                    </div>
                    <div class="row">
                        @foreach (var animeinfo in Model)
                        {

                            <div class="col-lg-4 col-md-6 col-sm-6">
                                <div class="product__item">
                                    @* <div class="product__item__pic set-bg" data-setbg="~/images/@anime.Image"> *@
                                    <div class="product__item__pic set-bg" data-setbg="/images/@animeinfo.Image">
                                    

                                            <div class="ep">@animeinfo.Episode</div>
                                            @* <div class="comment"><i class="fa fa-comments"></i> 11</div> *@
                                            <div class="view"><i class="fa fa-eye"></i> @animeinfo.ViewCount</div>
                                        </div>
                                    <div class="product__item__text">
                                        <ul>
                                            <li>@animeinfo.Type</li>
                                        </ul>
                                        <h5>
                                            <a asp-route-id="@animeinfo.AnimeId" asp-controller="Home" asp-action="AnimeDetail">@animeinfo.AnimeName</a>
                                        </h5>
                                        
                                     
                                    </div>
                                </div>
                            </div>
                        }

                    </div>


                </div>
            </div>
        </div>

</section>

